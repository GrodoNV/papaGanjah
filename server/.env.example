NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/papaganjah
DB_SSL=false
DB_LOGGING=false
DB_MIGRATIONS_RUN=false

# Autenticación
JWT_SECRET=reemplaza-este-secreto-con-al-menos-32-caracteres
JWT_EXPIRES_IN=8h

# Aplicación
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:4000
UPLOADS_DIR=uploads
UPLOAD_MAX_MB=20

# Correo transaccional (Resend tiene prioridad sobre SMTP)
MAIL_FROM="Papá Ganjah <no-reply@papaganjah.org>"
CONTACT_EMAIL=contacto@papaganjah.org
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Semilla del primer administrador
ADMIN_NAME=Administración Papá Ganjah
ADMIN_EMAIL=admin@papaganjah.org
ADMIN_PASSWORD=cambia-esta-password-segura
